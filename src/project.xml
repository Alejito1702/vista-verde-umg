package vistaverde.ui;

import javax.swing.*;
import javax.swing.border.*;
import java.awt.*;
import java.awt.event.*;

public abstract class VistaBase extends JFrame {

    protected static final Color BG_DARK    = new Color(10, 30, 15);
    protected static final Color BG_MID     = new Color(15, 50, 25);
    protected static final Color BG_CARD    = new Color(20, 70, 35);
    protected static final Color GREEN_MAIN = new Color(34, 139, 60);
    protected static final Color GREEN_LITE = new Color(144, 238, 144);
    protected static final Color GREEN_MED  = new Color(100, 200, 120);
    protected static final Color GREEN_BORD = new Color(50, 180, 80);
    protected static final Color RED_BTN    = new Color(180, 40, 40);

    private final JFrame menuRef;

    public VistaBase(String titulo, JFrame menuRef) {
        this.menuRef = menuRef;
        setTitle("Vista Verde - " + titulo);
        setSize(480, 420);
        setMinimumSize(new Dimension(380, 340));
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(menuRef);
        setResizable(true);
    }

    protected JPanel crearPanelFondo() {
        return new JPanel() {
            @Override protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                Graphics2D g2d = (Graphics2D) g;
                g2d.setPaint(new GradientPaint(0,0,BG_DARK,0,getHeight(),BG_MID));
                g2d.fillRect(0,0,getWidth(),getHeight());
            }
        };
    }

    protected JLabel lblTitulo(String texto) {
        JLabel l = new JLabel(texto);
        l.setFont(new Font("Segoe UI", Font.BOLD, 20));
        l.setForeground(GREEN_LITE);
        l.setAlignmentX(Component.CENTER_ALIGNMENT);
        return l;
    }

    protected JLabel lblCampo(String texto) {
        JLabel l = new JLabel(texto);
        l.setFont(new Font("Segoe UI", Font.BOLD, 12));
        l.setForeground(GREEN_MED);
        return l;
    }

    protected JTextField styledField() {
        JTextField f = new JTextField();
        f.setFont(new Font("Segoe UI", Font.PLAIN, 13));
        f.setBackground(new Color(15,45,25));
        f.setForeground(Color.WHITE);
        f.setCaretColor(Color.WHITE);
        f.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createMatteBorder(0,0,1,0,GREEN_BORD),
            BorderFactory.createEmptyBorder(4,6,4,6)));
        return f;
    }

    protected JComboBox<String> styledCombo(String[] items) {
        JComboBox<String> c = new JComboBox<>(items);
        c.setBackground(new Color(15,45,25));
        c.setForeground(Color.WHITE);
        c.setFont(new Font("Segoe UI", Font.PLAIN, 13));
        return c;
    }

    protected JButton btnPrincipal(String texto) {
        JButton btn = new JButton(texto) {
            @Override protected void paintComponent(Graphics g) {
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                g2.setColor(GREEN_MAIN);
                g2.fillRoundRect(0,0,getWidth(),getHeight(),20,20);
                g2.dispose();
                super.paintComponent(g);
            }
        };
        estilizarBtn(btn, Color.WHITE, new Color(200,255,200));
        return btn;
    }

    protected JButton btnRegresar() {
        JButton btn = new JButton("← Regresar") {
            @Override protected void paintComponent(Graphics g) {
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                g2.setColor(RED_BTN);
                g2.fillRoundRect(0,0,getWidth(),getHeight(),20,20);
                g2.dispose();
                super.paintComponent(g);
            }
        };
        estilizarBtn(btn, Color.WHITE, new Color(255,180,180));
        btn.addActionListener(e -> dispose());
        return btn;
    }

    private void estilizarBtn(JButton btn, Color normal, Color hover) {
        btn.setFont(new Font("Segoe UI", Font.BOLD, 13));
        btn.setForeground(normal);
        btn.setContentAreaFilled(false);
        btn.setBorderPainted(false);
        btn.setFocusPainted(false);
        btn.setCursor(new Cursor(Cursor.HAND_CURSOR));
        btn.setPreferredSize(new Dimension(160, 36));
        btn.addMouseListener(new MouseAdapter() {
            @Override public void mouseEntered(MouseEvent e) { btn.setForeground(hover);   btn.repaint(); }
            @Override public void mouseExited (MouseEvent e) { btn.setForeground(normal);  btn.repaint(); }
        });
    }

    protected JPanel filaForm(String etiqueta, JComponent campo) {
        JPanel row = new JPanel(new BorderLayout(10, 0));
        row.setOpaque(false);
        JLabel lbl = lblCampo(etiqueta);
        lbl.setPreferredSize(new Dimension(130, 28));
        row.add(lbl, BorderLayout.WEST);
        row.add(campo, BorderLayout.CENTER);
        return row;
    }

    protected void mostrarError(String msg) {
        JOptionPane.showMessageDialog(this, msg, "Error", JOptionPane.ERROR_MESSAGE);
    }

    protected void mostrarOk(String msg) {
        JOptionPane.showMessageDialog(this, msg, "Éxito", JOptionPane.INFORMATION_MESSAGE);
    }
}
